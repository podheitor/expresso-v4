# VM app — variáveis de ambiente
# Copie para app.env e preencha ANTES de executar o bootstrap.

# IPs privados das outras VMs
DATA_IP=<DATA_PRIVATE_IP>
MEET_IP=<MEET_PRIVATE_IP>
OBS_IP=<OBS_PRIVATE_IP>

# Domínio público
DOMAIN=<DOMINIO>

# Postgres (mesmo valor que data.env)
POSTGRES_USER=expresso
POSTGRES_PASSWORD=<SENHA_FORTE>

# MinIO (mesmo valor que data.env)
S3_ACCESS_KEY=expresso
S3_SECRET_KEY=<SENHA_FORTE>
S3_BUCKET=expresso

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<SENHA_FORTE>
KEYCLOAK_CLIENT_SECRET=<UUID_ALEATORIO>
KEYCLOAK_REALM=expresso
KEYCLOAK_CLIENT_ID=expresso-backend

# gov.br OIDC
GOVBR_CLIENT_ID=<ID_CADASTRADO_NO_GOVBR>
GOVBR_CLIENT_SECRET=<SECRET_GOVBR>

# NATS
NATS_URL=nats://<DATA_PRIVATE_IP>:4222

# E-mail
MAIL_DOMAIN=<DOMINIO>
DKIM_SELECTOR=default
DKIM_KEY_PATH=/etc/expresso/dkim/default.private

# TLS (Let's Encrypt)
LETSENCRYPT_EMAIL=<EMAIL_OPS>

# Observability
GRAFANA_ADMIN_PASSWORD=<SENHA_FORTE>
RUST_LOG=info
